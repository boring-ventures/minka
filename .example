# Supabase Project Settings
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database URLs
# Use connection pooling URL for DATABASE_URL
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use direct connection URL for migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Storage
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=avatars

# Email

# Libélula card payments
# Use the Libélula development key locally. Production values belong in Netlify environment variables.
LIBELULA_BASE_URL=https://api.libelula.bo
LIBELULA_APP_KEY=your-libelula-app-key
LIBELULA_CHECKOUT_SECRET=generate-a-random-64-character-secret
LIBELULA_RECONCILE_SECRET=generate-a-second-random-64-character-secret
LIBELULA_MERCHANT_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CARD_PAYMENTS_ENABLED=false
